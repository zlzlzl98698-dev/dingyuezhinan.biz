# 订阅指南 (dingyuezhinan.biz) Apache 静态部署配置
# 启用 Rewrite 引擎
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. 强制 HTTPS 与去掉 www 统一跳转到主域名 https://dingyuezhinan.biz
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.dingyuezhinan\.biz$ [NC]
  RewriteRule ^ https://dingyuezhinan.biz%{REQUEST_URI} [R=301,L,NE]

  # 2. 移除常见无意义追踪参数防止重复索引（保留业务参数除外）
  RewriteCond %{QUERY_STRING} (^|&)(utm_[^=]+|fbclid|gclid|spm)=[^&]* [NC]
  RewriteRule ^(.*)$ /$1? [R=301,L]
</IfModule>

# 3. 自定义 404 页面
ErrorDocument 404 /404.html

# 4. 目录默认索引
DirectoryIndex index.html

# 5. 安全响应头（不阻断搜索引擎爬虫抓取）与站内搜索页 noindex 响应头
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/search(/|$)" IS_SEARCH_PAGE
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Robots-Tag "noindex, nofollow" env=IS_SEARCH_PAGE
</IfModule>

# 6. 静态资源缓存策略
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# 7. Gzip / Brotli 压缩
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
