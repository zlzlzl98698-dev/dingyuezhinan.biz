---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = '常见问题与条件说明' } = Astro.props;
---

{items && items.length > 0 && (
  <section class="mt-10 pt-8 border-t border-slate-200" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl font-semibold text-ink mb-4">{title}</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="group rounded-lg border border-slate-200 bg-white p-4 open:border-brand/40">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-3 text-sm font-semibold text-ink">
            <span>{item.question}</span>
            <span class="text-xs font-mono text-brand shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-sm text-ink-muted leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
