---
import type { RelatedLink } from '../lib/internal-links';

interface Props {
  links: RelatedLink[];
  title?: string;
}

const { links, title = '延伸阅读与决策入口' } = Astro.props;
---

{links && links.length > 0 && (
  <section class="mt-10 pt-8 border-t border-slate-200" aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-xl font-semibold text-ink mb-4">{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {links.map((item) => (
        <a
          href={item.href}
          class="group rounded-xl border border-slate-200 bg-white p-4 hover:border-brand/50 hover:shadow-sm transition-all"
        >
          <div class="text-[11px] font-mono uppercase tracking-wider text-brand mb-1">
            {item.category}
          </div>
          <div class="text-sm font-semibold text-ink group-hover:text-brand transition-colors">
            {item.title}
          </div>
          <p class="mt-1 text-xs text-ink-muted line-clamp-2 leading-relaxed">{item.description}</p>
        </a>
      ))}
    </div>
  </section>
)}
