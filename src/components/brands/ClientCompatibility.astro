---
interface Props {
  brandName: string;
  mode: string;
  modeLabel: string;
  supportsProprietary: boolean;
  supportsThirdParty: boolean;
  recommendedClients: string[];
  dataStatus: string;
}

const {
  brandName,
  modeLabel,
  supportsProprietary,
  supportsThirdParty,
  recommendedClients,
  dataStatus,
} = Astro.props;
---

<section class="rounded-xl border border-slate-200 bg-white p-5 space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-base font-bold text-ink">{brandName} 客户端兼容性矩阵</h2>
    <span class="text-xs font-mono text-ink-faint">状态：{dataStatus}</span>
  </div>

  <p class="text-sm text-ink-muted leading-relaxed">
    当前记录显示使用方式为：<strong class="text-ink">{modeLabel}</strong>。
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
    <div class="rounded-lg border border-slate-200 p-3.5 bg-slate-50/70">
      <div class="font-semibold text-ink mb-1">官方专属客户端</div>
      <div class={supportsProprietary ? 'text-emerald-700 font-medium' : 'text-ink-faint'}>
        {supportsProprietary ? '资料记录提供专属客户端' : '未确认或仅走通用订阅'}
      </div>
    </div>
    <div class="rounded-lg border border-slate-200 p-3.5 bg-slate-50/70">
      <div class="font-semibold text-ink mb-1">第三方通用订阅（Clash / Shadowrocket）</div>
      <div class={supportsThirdParty ? 'text-emerald-700 font-medium' : 'text-rose-700 font-medium'}>
        {supportsThirdParty ? '支持第三方订阅链接导入' : '不提供或暂未确认通用订阅链接'}
      </div>
    </div>
  </div>

  <div>
    <div class="text-xs font-semibold text-ink-muted mb-2">适配说明与建议工具：</div>
    <div class="flex flex-wrap gap-2">
      {recommendedClients.map((client) => (
        <span class="px-2.5 py-1 rounded-md border border-slate-200 bg-slate-50 text-xs text-ink">
          {client}
        </span>
      ))}
    </div>
  </div>
</section>
