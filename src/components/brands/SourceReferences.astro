---
interface SourceItem {
  source: string;
  type: string;
  retrievedAt: string;
}

interface Props {
  brandName: string;
  sources: SourceItem[];
  conflicts: string[];
}

const { brandName, sources, conflicts } = Astro.props;
---

<section class="rounded-xl border border-slate-200 bg-slate-50/80 p-5 space-y-4">
  <h2 class="text-base font-bold text-ink">{brandName} 信息来源与冲突核实日志</h2>

  {conflicts.length > 0 && (
    <div class="rounded-lg border border-rose-200 bg-rose-50/80 p-4 space-y-1.5">
      <div class="text-xs font-bold text-rose-800">发现不同资料口径存在冲突（如实保留，未私自覆盖）：</div>
      <ul class="list-disc pl-5 text-xs text-rose-900 space-y-1">
        {conflicts.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  )}

  <div class="space-y-2">
    <div class="text-xs font-semibold text-ink-muted">原始资料溯源记录：</div>
    <ul class="space-y-1.5 text-xs font-mono text-ink-muted">
      {sources.map((s) => (
        <li class="flex flex-wrap items-center justify-between gap-2 bg-white border border-slate-200 rounded px-3 py-2">
          <span class="truncate">{s.source}</span>
          <span class="text-[11px] text-ink-faint">口径：{s.type} · 核对日期：{s.retrievedAt}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
