---
interface Props {
  brandName: string;
  enName: string;
  accentColor: string;
  foundedYear: string | null;
  routeType: string;
  protocols: string[];
  clientModeLabel: string;
  deviceLimit: string;
  entryText: string;
  dataStatus: string;
}

const {
  brandName,
  enName,
  accentColor,
  foundedYear,
  routeType,
  protocols,
  clientModeLabel,
  deviceLimit,
  entryText,
  dataStatus,
} = Astro.props;

const statusLabel =
  dataStatus === 'measured'
    ? 'Measured Data'
    : dataStatus === 'historical'
      ? 'Historical Data'
      : dataStatus === 'conflicting'
        ? 'Conflicting Sources'
        : dataStatus === 'unverified'
          ? 'Not Tested / Unverified'
          : 'Vendor Data';
---

<section
  class="relative rounded-xl border border-observatory-border bg-observatory-bg text-observatory-text p-5 sm:p-6 overflow-hidden"
  aria-label={`${brandName} 基础设施服务快照`}
>
  <div class="h-1 w-full absolute top-0 left-0" style={`background-color: ${accentColor}`}></div>

  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-observatory-border">
    <div class="flex items-center gap-3">
      <span class="w-2.5 h-2.5 rounded-full bg-observatory-cyan"></span>
      <div>
        <div class="text-[11px] font-mono uppercase tracking-wider text-observatory-muted">
          Infrastructure Service Snapshot
        </div>
        <h2 class="text-base sm:text-lg font-bold text-white">
          {brandName}（{enName}）核心技术档案
        </h2>
      </div>
    </div>
    <span class="px-2.5 py-1 rounded border border-observatory-border bg-observatory-panel text-[11px] font-mono text-observatory-cyan">
      {statusLabel}
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4 text-xs">
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">开业记录</div>
      <div class="mt-1 font-mono text-sm font-semibold text-white tabular-nums">
        {foundedYear ? `${foundedYear} 年（资料记录）` : 'Not Verified（未标注）'}
      </div>
    </div>
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">入门价格口径</div>
      <div class="mt-1 font-mono text-sm font-semibold text-observatory-emerald tabular-nums">
        {entryText}
      </div>
    </div>
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">设备并发上限</div>
      <div class="mt-1 text-sm font-semibold text-white">
        {deviceLimit}
      </div>
    </div>
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">传输线路定位</div>
      <div class="mt-1 text-xs font-medium text-observatory-text leading-relaxed">
        {routeType}
      </div>
    </div>
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">记录协议栈</div>
      <div class="mt-1 flex flex-wrap gap-1.5">
        {protocols.map((p) => (
          <span class="px-1.5 py-0.5 rounded bg-observatory-bg border border-observatory-border font-mono text-[11px] text-observatory-cyan">
            {p}
          </span>
        ))}
      </div>
    </div>
    <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3.5">
      <div class="text-observatory-muted font-mono text-[11px]">订阅与客户端模式</div>
      <div class="mt-1 text-xs font-medium text-observatory-text leading-relaxed">
        {clientModeLabel}
      </div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-observatory-border flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-observatory-muted">
    <span>注：以上参数按来源分类标注，不等同于全网长期 SLA 保证</span>
    <span class="text-white/30 select-none">订阅指南 · dingyuezhinan.biz</span>
  </div>
</section>
