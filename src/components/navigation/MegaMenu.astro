---
import { PILLAR_NAV } from '../../data/navigation';
---

<nav aria-label="主导航" class="hidden xl:flex items-center gap-0.5">
  {PILLAR_NAV.map((pillar) => (
    <div class="relative group">
      <a
        href={pillar.href}
        class="inline-flex items-center gap-1 px-2.5 py-2 text-[13px] font-medium text-ink hover:text-brand rounded-md hover:bg-slate-100/80 transition-colors whitespace-nowrap"
      >
        <span>{pillar.title}</span>
      </a>

      {/* Mega Menu Panel rendered directly in static HTML for crawler discovery */}
      <div
        class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50 w-[560px]"
      >
        <div class="rounded-xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5 p-5">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
            <div>
              <div class="text-xs font-mono text-brand uppercase tracking-wider">
                {pillar.order} · {pillar.system === 'guides' ? '教程知识体系' : pillar.system === 'reviews' ? '评测决策体系' : '商业转化体系'}
              </div>
              <div class="text-sm font-semibold text-ink mt-0.5">{pillar.title}专题总览</div>
            </div>
            <a
              href={pillar.href}
              class="text-xs font-medium text-brand hover:text-brand-hover bg-brand-soft px-2.5 py-1 rounded-md border border-brand-border/60"
            >
              进入专题首页
            </a>
          </div>

          <div class="grid grid-cols-2 gap-5">
            {pillar.groups.map((grp) => (
              <div>
                <div class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint mb-2">
                  {grp.label}
                </div>
                <ul class="space-y-1">
                  {grp.items.slice(0, 7).map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="block rounded-md px-2 py-1.5 hover:bg-slate-50 transition-colors group/item"
                      >
                        <div class="text-xs font-medium text-ink group-hover/item:text-brand">
                          {item.title}
                        </div>
                        <div class="text-[11px] text-ink-faint line-clamp-1">
                          {item.description}
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  ))}
</nav>
