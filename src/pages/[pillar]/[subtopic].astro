---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import TrafficCalculator from '../../components/tools/TrafficCalculator';
import CostComparisonTool from '../../components/tools/CostComparisonTool';
import SubscriptionMatcher from '../../components/tools/SubscriptionMatcher';
import BrandCard from '../../components/brands/BrandCard.astro';
import { PILLAR_NAV } from '../../data/navigation';
import brands from '../../data/brands.json';
import plans from '../../data/plans.json';

export async function getStaticPaths() {
  const subtopics = await getCollection('subtopics', ({ data }) => !data.draft);
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  const troubles = await getCollection('troubleshooting', ({ data }) => !data.draft);
  const knowledge = await getCollection('knowledge', ({ data }) => !data.draft);

  const paths: { params: { pillar: string; subtopic: string }; props: { entry: any; pillar: string; subtopic: string; kind: string } }[] = [];
  const seen = new Set<string>();

  const register = (entry: any, defaultPillar: string, kind: string) => {
    const idClean = entry.id.replace(/\.mdx?$/, '');
    const parts = idClean.includes('/') ? idClean.split('/') : [entry.data.pillar || defaultPillar, idClean];
    const pillar = parts[0];
    const subtopic = parts.slice(1).join('-');
    // Skip clients/compare/reviews as they have dedicated static routes
    if (['clients', 'compare', 'reviews'].includes(pillar)) return;
    if (subtopic === 'index') return;
    const key = `${pillar}/${subtopic}`;
    if (seen.has(key)) return;
    seen.add(key);
    paths.push({
      params: { pillar, subtopic },
      props: { entry, pillar, subtopic, kind },
    });
  };

  subtopics.forEach((e) => register(e, 'guides', 'subtopic'));
  guides.forEach((e) => register(e, 'guides', 'article'));
  troubles.forEach((e) => register(e, 'troubleshooting', 'article'));
  knowledge.forEach((e) => register(e, 'risks', 'article'));

  return paths;
}

const { entry, pillar, subtopic } = Astro.props;
const { Content, headings } = await render(entry);

const navPillar = PILLAR_NAV.find((p) => p.id === pillar);
const urlPath = `/${pillar}/${subtopic}/`;

// Live database slices for data-backed commercial subtopics
const noExpiryPlans = plans
  .filter((p) => p.isNoExpiry && p.priceCny !== null)
  .sort((a, b) => (a.costPerGbCny ?? 99) - (b.costPerGbCny ?? 99))
  .slice(0, 15);

const monthlyPlans = plans
  .filter((p) => p.billingCycle === 'monthly' && !p.isCustom && p.priceCny !== null)
  .sort((a, b) => (a.priceCny ?? 999) - (b.priceCny ?? 999))
  .slice(0, 15);

const annualPlans = plans
  .filter((p) => p.billingCycle === 'annual' && p.priceCny !== null)
  .sort((a, b) => (a.effectiveMonthlyCny ?? 999) - (b.effectiveMonthlyCny ?? 999))
  .slice(0, 15);

const highTrafficPlans = plans
  .filter((p) => !p.isCustom && p.trafficGb && p.trafficGb >= 500)
  .sort((a, b) => (a.effectiveMonthlyCny ?? a.priceCny ?? 999) - (b.effectiveMonthlyCny ?? b.priceCny ?? 999))
  .slice(0, 15);

const brandMap = Object.fromEntries(brands.map((b) => [b.slug, b]));

const featuredBrands = [...brands].sort((a, b) => a.priorityRank - b.priorityRank).slice(0, 3);
const showCalculator = urlPath === '/plans/traffic-calculator/';
const showCostTool = urlPath === '/plans/cost-comparison/';
const showMatcher = urlPath === '/guides/subscription-selection/' || urlPath === '/recommend/beginner/';

const tablePlans =
  urlPath === '/plans/no-expiry/'
    ? noExpiryPlans
    : urlPath === '/plans/monthly/'
      ? monthlyPlans
      : urlPath === '/plans/annual/'
        ? annualPlans
        : urlPath === '/plans/high-traffic/'
          ? highTrafficPlans
          : [];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.title.replace(/\s*\|\s*订阅指南$/, '')}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: navPillar?.title || pillar, url: navPillar?.href || `/${pillar}/` },
    { name: entry.data.primaryKeyword, url: urlPath },
  ]}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  reviewer={entry.data.reviewer}
  dataStatus={entry.data.dataStatus}
  tags={entry.data.tags}
  faq={entry.data.faq}
  showDisclosure={['recommend', 'plans', 'brands', 'vpn', 'ai-streaming'].includes(pillar)}
  headings={headings}
  readingMinutes={Math.max(2, Math.ceil((entry.body?.length || 1000) / 450))}
  relatedLinks={[
    { title: `返回${navPillar?.title || pillar}专题首页`, href: navPillar?.href || `/${pillar}/`, category: '所属一级专题', description: navPillar?.tagline || '浏览该专题下全部细分指南' },
    { title: '光速云旗舰深度评测', href: '/reviews/guangsuyun/', category: '品牌评测', description: '查看光速云 7 档套餐与 2026-08-19 实测截图' },
    { title: '机场品牌大全（31家去重库）', href: '/brands/', category: '品牌数据库', description: '按协议、客户端兼容模式与预算筛选全部收录品牌' },
    { title: '代理客户端兼容性查询', href: '/clients/', category: '客户端知识库', description: '确认第三方订阅或专属 App 是否适配你的设备' },
  ]}
>
  {showCalculator && <TrafficCalculator client:load plans={plans} brands={brands} />}
  {showCostTool && <CostComparisonTool client:load plans={plans} brands={brands} />}
  {showMatcher && <SubscriptionMatcher client:load brands={brands} />}

  {tablePlans.length > 0 && (
    <section class="rounded-xl border border-slate-200 bg-white overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 bg-slate-50/70">
        <h2 class="text-base font-bold text-ink">数据库真实套餐实时汇编（来自 `plans.json`）</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-ink-muted font-semibold">
              <th class="py-3 px-4">品牌</th>
              <th class="py-3 px-3">套餐名称</th>
              <th class="py-3 px-3">周期</th>
              <th class="py-3 px-3">记录价格</th>
              <th class="py-3 px-3">流量配额</th>
              <th class="py-3 px-4">每 GB 成本</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-mono tabular-nums">
            {tablePlans.map((p) => {
              const b = brandMap[p.brandSlug];
              return (
                <tr class="hover:bg-slate-50">
                  <td class="py-2.5 px-4 font-sans font-semibold">
                    <a href={b?.reviewUrl || '/brands/'} class="text-brand hover:underline">{b?.name || p.brandSlug}</a>
                  </td>
                  <td class="py-2.5 px-3 font-sans text-ink">{p.planName}</td>
                  <td class="py-2.5 px-3 font-sans text-ink-muted">{p.billingCycleLabel}</td>
                  <td class="py-2.5 px-3 font-semibold text-ink">{p.priceRaw}</td>
                  <td class="py-2.5 px-3 text-ink">{p.trafficRaw}</td>
                  <td class="py-2.5 px-4 text-brand">{p.costPerGbCny !== null ? `¥${p.costPerGbCny}/GB` : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <div class="prose-editorial bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
    <Content />
  </div>

  {['recommend', 'plans'].includes(pillar) && (
    <section class="space-y-4">
      <h2 class="text-lg font-bold text-ink">重点关联品牌评测参考</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {featuredBrands.map((b) => (
          <BrandCard brand={b} />
        ))}
      </div>
    </section>
  )}
</ArticleLayout>
