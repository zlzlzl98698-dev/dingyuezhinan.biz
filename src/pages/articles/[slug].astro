---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { PILLAR_NAV } from '../../data/navigation';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);
const navPillar = PILLAR_NAV.find((p) => p.id === entry.data.pillar);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.title.replace(/\s*\|\s*订阅指南$/, '')}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: navPillar?.title || '专题指南', url: navPillar?.href || '/guides/' },
    { name: entry.data.primaryKeyword, url: `/articles/${slug}/` },
  ]}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  reviewer={entry.data.reviewer}
  dataStatus={entry.data.dataStatus}
  tags={entry.data.tags}
  faq={entry.data.faq}
  headings={headings}
  readingMinutes={Math.max(3, Math.ceil((entry.body?.length || 1200) / 450))}
  relatedLinks={[
    { title: `进入${navPillar?.title || '客户端'}一级专题`, href: navPillar?.href || '/clients/', category: '所属专题', description: navPillar?.tagline || '查看更多同类实践教程与工具' },
    { title: '代理客户端兼容性查询', href: '/clients/', category: '客户端库', description: '核查主流品牌是否支持第三方订阅与对应系统' },
    { title: '订阅更新与节点超时排查', href: '/troubleshooting/node-timeout/', category: '故障排查', description: '逐项排查本地网络、时间同步与端口冲突' },
    { title: '机场品牌大全（31家）', href: '/brands/', category: '品牌数据库', description: '对比 31 家机场品牌套餐、协议与实测状态' },
  ]}
>
  <div class="prose-editorial bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
    <Content />
  </div>
</ArticleLayout>
