---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import clients from '../../data/clients.json';
import { buildSoftwareSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('clients', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = entry.data.clientSlug || entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);
const clientObj = clients.find((c) => c.slug === slug);

const softwareSchema = clientObj
  ? buildSoftwareSchema({
      name: clientObj.name,
      platforms: clientObj.platforms,
      url: `/clients/${slug}/`,
      description: entry.data.description,
      isFree: clientObj.pricing.includes('免费'),
    })
  : null;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.title.replace(/\s*\|\s*订阅指南$/, '')}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '客户端软件', url: '/clients/' },
    { name: clientObj?.name || entry.data.primaryKeyword, url: `/clients/${slug}/` },
  ]}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  reviewer={entry.data.reviewer}
  dataStatus={entry.data.dataStatus}
  tags={entry.data.tags}
  faq={entry.data.faq}
  extraSchemas={softwareSchema ? [softwareSchema] : []}
  headings={headings}
  readingMinutes={Math.max(2, Math.ceil((entry.body?.length || 1000) / 450))}
  relatedLinks={[
    { title: '客户端兼容性查询器', href: '/clients/', category: '数据库', description: '反查 31 家机场对不同客户端的支持状态' },
    { title: '订阅链接导入与使用说明', href: '/guides/subscription-url/', category: '教程', description: '理解 Base64 与 Clash YAML 配置导入流程' },
    { title: '专属客户端与第三方客户端对比', href: '/clients/proprietary-vs-third-party/', category: '对比', description: '不能导出订阅链接的机场该如何权衡' },
    { title: '订阅更新报错与连接排查', href: '/troubleshooting/subscription-update-failed/', category: '排障', description: '遇到节点拉取失败时的快速修复指南' },
  ]}
>
  {clientObj && (
    <div class="rounded-xl border border-observatory-border bg-observatory-bg text-observatory-text p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
      <div>
        <div class="text-observatory-muted font-mono">软件定位</div>
        <div class="font-semibold text-white mt-1">{clientObj.category}</div>
      </div>
      <div>
        <div class="text-observatory-muted font-mono">支持系统</div>
        <div class="font-mono text-observatory-cyan mt-1">{clientObj.platforms.join(' / ')}</div>
      </div>
      <div>
        <div class="text-observatory-muted font-mono">核心与授权</div>
        <div class="text-white mt-1">{clientObj.cores.join(', ')} · {clientObj.pricing}</div>
      </div>
      <div>
        <div class="text-observatory-muted font-mono">官方项目入口（核实于 {clientObj.verifiedAt}）</div>
        <a
          href={clientObj.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-1 font-mono text-observatory-emerald hover:underline break-all"
        >
          {clientObj.officialType} →
        </a>
      </div>
    </div>
  )}

  <div class="prose-editorial bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
    <Content />
  </div>
</ArticleLayout>
