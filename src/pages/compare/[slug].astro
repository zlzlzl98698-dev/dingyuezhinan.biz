---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('compare', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.title.replace(/\s*\|\s*订阅指南$/, '')}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '横向对比', url: '/compare/' },
    { name: entry.data.primaryKeyword, url: `/compare/${slug}/` },
  ]}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  reviewer={entry.data.reviewer}
  dataStatus={entry.data.dataStatus}
  tags={entry.data.tags}
  faq={entry.data.faq}
  showDisclosure={true}
  headings={headings}
  readingMinutes={Math.max(3, Math.ceil((entry.body?.length || 1200) / 450))}
  relatedLinks={[
    { title: '光速云旗舰深度评测', href: '/reviews/guangsuyun/', category: '品牌评测', description: '查看光速云 7 档套餐与 08-19 实测截图' },
    { title: '机场品牌大全（31家）', href: '/brands/', category: '数据库', description: '按客户端与预算筛选更多备选机场' },
    { title: '机场订阅费用与单GB对比工具', href: '/plans/cost-comparison/', category: '工具', description: '自行输入折扣后价格测算单 GB 成本' },
    { title: '机场套餐购买决策指南', href: '/guides/subscription-selection/', category: '决策', description: '如何避免冲动年付、先月付试水' },
  ]}
>
  <div class="prose-editorial bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
    <Content />
  </div>
</ArticleLayout>
