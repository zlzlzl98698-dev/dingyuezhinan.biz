---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandCard from '../components/brands/BrandCard.astro';
import AffiliateDisclosure from '../components/brands/AffiliateDisclosure.astro';
import SubscriptionMatcher from '../components/tools/SubscriptionMatcher';
import FAQ from '../components/FAQ.astro';
import brands from '../data/brands.json';
import clients from '../data/clients.json';
import geoQuestions from '../data/geo-questions.json';
import { PILLAR_NAV, SITE_INFO } from '../data/navigation';
import { getAffiliateLink } from '../data/affiliate-links';
import { buildFAQSchema } from '../lib/seo';
import { Search, ShieldCheck, Layers, Cpu, Wrench, AlertTriangle, ArrowRight } from 'lucide-react';

const sortedBrands = [...brands].sort((a, b) => a.priorityRank - b.priorityRank);
const guangsuyun = sortedBrands.find((b) => b.slug === 'guangsuyun')!;
const gsyAff = getAffiliateLink('guangsuyun');
const hotBrands = sortedBrands.slice(1, 7);

const homeFaqs = geoQuestions.slice(0, 6).map((q) => ({
  question: q.question,
  answer: q.answerSummary,
}));
const faqSchema = buildFAQSchema(homeFaqs);
---

<BaseLayout
  title="订阅指南（dingyuezhinan.biz）· 从订阅选择到日常使用，一站式网络订阅指南"
  description="订阅指南是专注网络订阅知识库、31家机场品牌去重评测数据库、流量与成本计算器及全平台代理客户端指南的独立决策平台。"
  structuredData={faqSchema ? [faqSchema] : []}
  tags={['订阅指南', '机场推荐', '光速云评测', '机场流量计算器', 'Clash Verge Rev', 'IEPL专线']}
>
  <div data-pagefind-body>
    {/* 2. Hero 首屏：非居中不对称架构 + 搜索 + 新手决策入口 */}
    <section class="border-b border-slate-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-brand-soft px-3 py-1 text-xs font-mono text-brand">
            <span>Subscription Guide · dingyuezhinan.biz</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink leading-[1.12]">
            {SITE_INFO.slogan}
          </h1>
          <p class="text-base text-ink-muted max-w-2xl leading-relaxed">
            不只是罗列推荐链接。我们通过 31 家去重品牌档案、214 档套餐核算、2026-08-11/08-19 实测截图与客户端兼容库，帮你解决“买多少流量、选月付还是年付、用什么客户端以及出故障怎么查”的完整链路问题。
          </p>

          <form action="/search/" method="get" class="flex flex-col sm:flex-row gap-2.5 max-w-xl pt-1">
            <div class="relative flex-1">
              <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input
                type="search"
                name="q"
                placeholder="搜索品牌（光速云）、客户端（Clash Verge Rev）或报错..."
                class="w-full rounded-lg border border-slate-300 bg-white pl-10 pr-3 py-2.5 text-sm text-ink focus:outline-none focus:border-brand"
              />
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 rounded-lg bg-brand hover:bg-brand-hover text-white text-sm font-medium transition-colors shrink-0"
            >
              全站搜索
            </button>
          </form>

          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
            <a href="/guides/subscription-selection/" class="inline-flex items-center gap-1 font-semibold text-brand hover:underline">
              <span>新手买前决策中心</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
            <span class="text-slate-300">|</span>
            <a href="/plans/traffic-calculator/" class="text-ink-muted hover:text-brand">每月流量需求计算器</a>
            <span class="text-slate-300">|</span>
            <a href="/brands/" class="text-ink-muted hover:text-brand">31 家机场品牌库</a>
            <span class="text-slate-300">|</span>
            <a href="/troubleshooting/" class="text-ink-muted hover:text-brand">订阅异常排障</a>
          </div>
        </div>

        {/* Right Telemetry Snapshot Card */}
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-observatory-border bg-observatory-bg text-observatory-text p-5 sm:p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-observatory-border pb-3">
              <div>
                <div class="text-[11px] font-mono text-observatory-cyan uppercase">Network Observatory Database</div>
                <div class="text-sm font-bold text-white mt-0.5">站内全量核验数据库快照</div>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-observatory-emerald" title="Operational"></span>
            </div>

            <div class="grid grid-cols-2 gap-3 font-mono">
              <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3">
                <div class="text-[11px] text-observatory-muted font-sans">去重独立机场品牌</div>
                <div class="text-xl font-bold text-white tabular-nums mt-0.5">31 家</div>
              </div>
              <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3">
                <div class="text-[11px] text-observatory-muted font-sans">已解析套餐档案</div>
                <div class="text-xl font-bold text-observatory-cyan tabular-nums mt-0.5">214 档</div>
              </div>
              <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3">
                <div class="text-[11px] text-observatory-muted font-sans">含原始实测截图</div>
                <div class="text-xl font-bold text-observatory-emerald tabular-nums mt-0.5">15 家</div>
              </div>
              <div class="rounded-lg border border-observatory-border bg-observatory-panel p-3">
                <div class="text-[11px] text-observatory-muted font-sans">第三方客户端词条</div>
                <div class="text-xl font-bold text-white tabular-nums mt-0.5">{clients.length} 款</div>
              </div>
            </div>

            <div class="rounded-lg border border-observatory-border bg-observatory-panel/70 p-3 text-xs text-observatory-muted leading-relaxed">
              所有数据均区分 <strong class="text-white">Measured / Vendor / Historical / Unverified / Conflicting</strong> 五种状态，不以商业排序替代实测结果。
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 space-y-14">
      <AffiliateDisclosure />

      {/* 3. 机场订阅选择中心 */}
      <section aria-labelledby="decision-center-heading" class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <div>
            <div class="text-xs font-mono text-brand uppercase tracking-wider">01 · Interactive Decision Center</div>
            <h2 id="decision-center-heading" class="text-2xl font-bold text-ink mt-0.5">机场订阅选择中心</h2>
          </div>
          <a href="/plans/traffic-calculator/" class="text-xs font-medium text-brand hover:underline">
            先算算每月需要多少 GB →
          </a>
        </div>
        <SubscriptionMatcher client:visible brands={sortedBrands} />
      </section>

      {/* 4. 主推光速云精选品牌卡片 */}
      <section aria-labelledby="flagship-heading" class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <div>
            <div class="text-xs font-mono text-brand uppercase tracking-wider">02 · Flagship Partner Spotlight</div>
            <h2 id="flagship-heading" class="text-2xl font-bold text-ink mt-0.5">第一主推旗舰品牌：光速云（2020年运营）</h2>
          </div>
          <span class="text-xs font-mono text-ink-faint">优惠码：AMM · 含 59GB/69GB 口径公开核对</span>
        </div>

        <div class="rounded-2xl border border-brand/30 bg-white p-6 sm:p-8 shadow-sm">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            <div class="lg:col-span-8 space-y-4">
              <div class="flex items-center gap-4">
                <img
                  src={guangsuyun.thumbLogo || guangsuyun.logo}
                  alt="光速云品牌主图"
                  width="64"
                  height="64"
                  class="w-16 h-16 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0"
                />
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-xl font-bold text-ink">{guangsuyun.name}（{guangsuyun.enName}）</h3>
                    <span class="px-2 py-0.5 rounded bg-brand text-white text-[11px] font-mono">站内旗舰合作品牌</span>
                    <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-mono">含 08-11 & 08-19 实测截图</span>
                  </div>
                  <p class="text-xs text-ink-muted mt-1">
                    {guangsuyun.routeType} · {guangsuyun.clientModeLabel} · 支持支付宝 / 微信 / USDT
                  </p>
                </div>
              </div>

              <p class="text-sm text-ink-muted leading-relaxed">
                {guangsuyun.introSummary} 本站已对光速云 7 档套餐（含 147 元 247GB 永久套餐与 99 元/年轻量版）、5 张 2026-08-19 运营商测速与流媒体截图，以及 59GB 与 69GB 文档差异进行了逐条审计。
              </p>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
                <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
                  <div class="text-ink-faint font-sans">年付入门折算</div>
                  <div class="text-sm font-bold text-brand mt-0.5">¥99/年（约¥8.25/月）</div>
                </div>
                <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
                  <div class="text-ink-faint font-sans">标准月付起步</div>
                  <div class="text-sm font-bold text-ink mt-0.5">¥25/月 · 168GB</div>
                </div>
                <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
                  <div class="text-ink-faint font-sans">永久不限时包</div>
                  <div class="text-sm font-bold text-ink mt-0.5">¥147 / 247GB</div>
                </div>
                <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
                  <div class="text-ink-faint font-sans">新人优惠码</div>
                  <div class="text-sm font-bold text-emerald-700 mt-0.5">AMM</div>
                </div>
              </div>
            </div>

            <div class="lg:col-span-4 flex flex-col gap-3 border-t lg:border-t-0 lg:border-l border-slate-200 pt-5 lg:pt-0 lg:pl-6">
              <a
                href="/reviews/guangsuyun/"
                class="w-full text-center px-4 py-3 rounded-lg bg-brand hover:bg-brand-hover text-white text-sm font-semibold transition-colors"
              >
                阅读光速云万字旗舰评测
              </a>
              {gsyAff?.registerUrl && (
                <a
                  href={gsyAff.registerUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="w-full text-center px-4 py-2.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-ink text-xs font-semibold transition-colors"
                >
                  访问光速云推广注册入口 ↗
                </a>
              )}
              <div class="grid grid-cols-2 gap-2 text-xs text-center">
                <a href="/guides/guangsuyun-147-permanent-plan-cost/" class="rounded-md bg-slate-50 hover:bg-slate-100 py-2 px-2 text-ink-muted">
                  147永久套餐拆解
                </a>
                <a href="/compare/guangsuyun-vs-feimao/" class="rounded-md bg-slate-50 hover:bg-slate-100 py-2 px-2 text-ink-muted">
                  对比飞猫云
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 5. 热门机场品牌推荐与评测入口 */}
      <section aria-labelledby="hot-brands-heading" class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-2">
          <div>
            <div class="text-xs font-mono text-brand uppercase tracking-wider">03 · Brand Directory</div>
            <h2 id="hot-brands-heading" class="text-2xl font-bold text-ink mt-0.5">热门机场品牌评测入口（商业精选序列）</h2>
          </div>
          <a href="/brands/" class="text-xs font-medium text-brand hover:underline">查看全部 31 家独立品牌 →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {hotBrands.map((b) => (
            <BrandCard brand={b} />
          ))}
        </div>
      </section>

      {/* 6 & 7. 套餐预算分类与周期指南 */}
      <section aria-labelledby="plans-guide-heading" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7 rounded-xl border border-slate-200 bg-white p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 id="plans-guide-heading" class="text-lg font-bold text-ink">套餐预算分类与真实成本区间</h2>
            <a href="/plans/" class="text-xs font-medium text-brand hover:underline">套餐全库 →</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <a href="/plans/budget/" class="rounded-lg border border-slate-200 p-3.5 hover:border-brand/50">
              <div class="font-bold text-ink">年付 ¥60–¥100 档（约 ¥5.6–¥8.3/月）</div>
              <p class="text-ink-muted mt-1">包含 5.6 元同质化入门组、飞猫云学生版与光速云轻量版，适合低频轻用。</p>
            </a>
            <a href="/plans/monthly/" class="rounded-lg border border-slate-200 p-3.5 hover:border-brand/50">
              <div class="font-bold text-ink">月付 ¥18–¥27 档（100GB–168GB）</div>
              <p class="text-ink-muted mt-1">资金锁定最低的试水主力档，涵盖光速云极速版、暮光基础版、一翻云轻享版。</p>
            </a>
            <a href="/plans/no-expiry/" class="rounded-lg border border-slate-200 p-3.5 hover:border-brand/50">
              <div class="font-bold text-ink">一次性不限时流量包（¥99 起）</div>
              <p class="text-ink-muted mt-1">15 家品牌提供永久流量包，适合出差备份或每月用量低于 20GB 的用户。</p>
            </a>
            <a href="/plans/high-traffic/" class="rounded-lg border border-slate-200 p-3.5 hover:border-brand/50">
              <div class="font-bold text-ink">大流量与团队档（500GB–2TB/月）</div>
              <p class="text-ink-muted mt-1">适配 4K 流媒体、远程协作与高并发需求，按单 GB 成本比小包更低。</p>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 rounded-xl border border-slate-200 bg-white p-6 space-y-4">
          <h2 class="text-lg font-bold text-ink">月付、年付、不限时怎么选？</h2>
          <ul class="space-y-3 text-xs text-ink-muted leading-relaxed">
            <li class="border-l-2 border-brand pl-3">
              <strong class="text-ink">初次接触新品牌优先选月付：</strong> 哪怕年付折算只要 8 元/月，仍建议先用 20–25 元月付实测晚高峰与常用软件解锁。
            </li>
            <li class="border-l-2 border-emerald-500 pl-3">
              <strong class="text-ink">备用或极低频需求看重不限时：</strong> 避免月重置流量月底清零浪费，但需知晓不限时以商家持续运营为前提。
            </li>
            <li class="border-l-2 border-amber-500 pl-3">
              <strong class="text-ink">续费或升级前先算单 GB 账：</strong> 使用 <a href="/plans/cost-comparison/" class="text-brand underline">订阅费用对比工具</a> 确认年付折扣是否真划算。
            </li>
          </ul>
        </div>
      </section>

      {/* 8 & 9. 横向对比与 AI 流媒体 */}
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-6 space-y-3">
          <div class="flex items-center gap-2 text-brand text-xs font-mono">
            <Layers className="w-4 h-4" />
            <span>COMPARE & REVIEWS</span>
          </div>
          <h2 class="text-lg font-bold text-ink">热门品牌双边对比与深度评测</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="/compare/guangsuyun-vs-feimao/" class="text-ink hover:text-brand font-medium">· 光速云 vs 飞猫云：双支持与纯专属客户端差异</a></li>
            <li><a href="/compare/guangsuyun-vs-muguang/" class="text-ink hover:text-brand font-medium">· 光速云 vs 暮光加速：7档套餐与多端策略对比</a></li>
            <li><a href="/compare/guangsuyun-vs-xingdaomeng/" class="text-ink hover:text-brand font-medium">· 光速云 vs 星岛梦：2020老牌的套餐与协议对照</a></li>
            <li><a href="/compare/guangsuyun-vs-ermao/" class="text-ink hover:text-brand font-medium">· 光速云 vs 二猫云：起始门槛与节点覆盖差异</a></li>
            <li><a href="/compare/guangsuyun-vs-weitu/" class="text-ink hover:text-brand font-medium">· 光速云 vs 唯兔云：14.9元档与双线架构怎么选</a></li>
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 space-y-3">
          <div class="flex items-center gap-2 text-brand text-xs font-mono">
            <Cpu className="w-4 h-4" />
            <span>AI & STREAMING</span>
          </div>
          <h2 class="text-lg font-bold text-ink">AI 工具与海外流媒体兼容性专题</h2>
          <ul class="space-y-2 text-sm">
            <li><a href="/ai-streaming/chatgpt/" class="text-ink hover:text-brand font-medium">· ChatGPT 机场：香港节点“仅APP可用”现象实测解读</a></li>
            <li><a href="/ai-streaming/claude/" class="text-ink hover:text-brand font-medium">· Claude 机场：风控敏感场景的节点挑选建议</a></li>
            <li><a href="/ai-streaming/gemini/" class="text-ink hover:text-brand font-medium">· Gemini 机场：为什么多数品牌标为“视节点而定”</a></li>
            <li><a href="/ai-streaming/netflix/" class="text-ink hover:text-brand font-medium">· Netflix / Disney+ / YouTube 解锁与“送中”排查</a></li>
            <li><a href="/ai-streaming/availability-testing/" class="text-ink hover:text-brand font-medium">· 如何看懂 MiaoKo 与 RegionRestrictionCheck 报告</a></li>
          </ul>
        </div>
      </section>

      {/* 10, 11, 12, 13. 客户端、排障、网络与避坑四联知识矩阵 */}
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3">
          <div class="text-xs font-mono text-brand">05 · CLIENTS</div>
          <h2 class="text-base font-bold text-ink">客户端软件指南</h2>
          <p class="text-xs text-ink-muted leading-relaxed">覆盖 Windows、macOS、Android、iOS、Linux 与 OpenWrt 软路由的官方正版入口。</p>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/clients/clash-verge-rev/" class="text-brand hover:underline">Clash Verge Rev 桌面端</a></li>
            <li><a href="/clients/v2rayn/" class="text-brand hover:underline">v2rayN 多核心客户端</a></li>
            <li><a href="/clients/shadowrocket/" class="text-brand hover:underline">Shadowrocket 小火箭 iOS</a></li>
            <li><a href="/clients/proprietary-vs-third-party/" class="text-brand hover:underline">专属客户端与通用订阅对比</a></li>
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3">
          <div class="text-xs font-mono text-brand flex items-center gap-1.5"><Wrench className="w-3.5 h-3.5" />09 · TROUBLESHOOT</div>
          <h2 class="text-base font-bold text-ink">常见订阅故障排查</h2>
          <p class="text-xs text-ink-muted leading-relaxed">订阅拉取报错、节点全部超时、TUN 网卡冲突与 DNS 异常的一线排障手册。</p>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/troubleshooting/subscription-update-failed/" class="text-brand hover:underline">订阅更新错误与 YAML 报错</a></li>
            <li><a href="/troubleshooting/node-timeout/" class="text-brand hover:underline">节点超时与系统时间偏差</a></li>
            <li><a href="/troubleshooting/tun-error/" class="text-brand hover:underline">TUN 模式异常修复方法</a></li>
            <li><a href="/troubleshooting/chatgpt-only-app-hk-explained/" class="text-brand hover:underline">香港节点 ChatGPT 仅限 APP 原因</a></li>
          </ul>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3">
          <div class="text-xs font-mono text-brand">07 · NETWORK</div>
