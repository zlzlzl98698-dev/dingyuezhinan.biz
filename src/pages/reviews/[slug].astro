---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import BrandOverviewChart from '../../components/charts/BrandOverviewChart.astro';
import SpeedReportChart from '../../components/charts/SpeedReportChart.astro';
import AvailabilityMatrixChart from '../../components/charts/AvailabilityMatrixChart.astro';
import NetworkPathChart from '../../components/charts/NetworkPathChart.astro';
import PricingTable from '../../components/brands/PricingTable.astro';
import ClientCompatibility from '../../components/brands/ClientCompatibility.astro';
import SourceReferences from '../../components/brands/SourceReferences.astro';
import CopyCouponButton from '../../components/brands/CopyCouponButton';
import brands from '../../data/brands.json';
import plans from '../../data/plans.json';
import benchmarks from '../../data/benchmarks.json';
import unlocks from '../../data/unlock-results.json';
import compatList from '../../data/client-compatibility.json';
import sourceList from '../../data/brand-sources.json';
import { getAffiliateLink } from '../../data/affiliate-links';
import { getDefaultCrossLinksForReview, getPeerAlternatives } from '../../lib/internal-links';

export async function getStaticPaths() {
  const entries = await getCollection('reviews', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const slug = entry.data.brandSlug || entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);

const brand = brands.find((b) => b.slug === slug);
const brandPlans = plans.filter((p) => p.brandSlug === slug);
const benchmark = benchmarks.find((b) => b.brandSlug === slug);
const unlock = unlocks.find((u) => u.brandSlug === slug);
const compat = compatList.find((c) => c.brandSlug === slug);
const sourceObj = sourceList.find((s) => s.brandSlug === slug);
const aff = getAffiliateLink(slug);

const relatedLinks = [
  ...getDefaultCrossLinksForReview(slug),
  ...getPeerAlternatives(slug, 2),
];

const entryLabel = brand?.entryMonthlyPriceCny
  ? `月付 ¥${brand.entryMonthlyPriceCny} 起`
  : brand?.entryAnnualEffectiveMonthlyCny
    ? `年付折算约 ¥${brand.entryAnnualEffectiveMonthlyCny}/月`
    : '待核实';
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.title.replace(/\s*\|\s*订阅指南$/, '')}
  category={entry.data.category}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '机场品牌', url: '/brands/' },
    { name: '深度评测', url: '/reviews/' },
    { name: brand?.name || slug, url: `/reviews/${slug}/` },
  ]}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  reviewer={entry.data.reviewer}
  dataStatus={entry.data.dataStatus}
  tags={entry.data.tags}
  faq={entry.data.faq}
  relatedLinks={relatedLinks}
  showDisclosure={true}
  aboutId={brand?.id}
  ogImage={brand?.logo}
  headings={headings}
  readingMinutes={Math.max(3, Math.ceil((entry.body?.length || 1500) / 450))}
>
  {brand && (
    <div class="rounded-xl border border-slate-200 bg-white p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <img
          src={brand.thumbLogo || brand.logo}
          alt={`${brand.name} 官方图标`}
          width="56"
          height="56"
          class="w-14 h-14 rounded-xl object-cover border border-slate-200 bg-slate-50 shrink-0"
        />
        <div>
          <div class="text-base font-bold text-ink">{brand.name}（{brand.enName}）</div>
          <div class="text-xs text-ink-muted mt-0.5">
            {brand.coupons.length > 0
              ? `记录优惠码：${brand.coupons.map((c) => `${c.code}（${c.discount}）`).join(' / ')}`
              : '优惠码信息待核实'}
          </div>
          {brand.coupons.some((c) => c.code && c.code !== '待核实') && (
            <div class="mt-2 flex flex-wrap items-center gap-2">
              {brand.coupons
                .filter((c) => c.code && c.code !== '待核实')
                .map((c) => (
                  <CopyCouponButton client:load code={c.code} discount={c.discount} />
                ))}
            </div>
          )}
          {aff?.urlFormatWarning && (
            <div class="text-[11px] text-rose-700 mt-1">
              注意：原始资料中的注册链接缺少 SPA hash 符号 #，打开前请确认页面能正常加载。
            </div>
          )}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        {aff?.registerUrl && !aff.isHistoricalUrl ? (
          <a
            href={aff.registerUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-4 py-2.5 rounded-lg bg-brand hover:bg-brand-hover text-white text-xs font-semibold transition-colors"
          >
            访问{brand.name}注册入口
          </a>
        ) : aff?.registerUrl && aff.isHistoricalUrl ? (
          <a
            href={aff.registerUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-4 py-2.5 rounded-lg border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-900 text-xs font-semibold transition-colors"
          >
            查看历史保存入口（不保证有效）
          </a>
        ) : (
          <span class="px-3 py-2 rounded-lg bg-slate-100 text-xs text-ink-faint">暂无可用推广入口</span>
        )}
      </div>
    </div>
  )}

  {brand && (
    <BrandOverviewChart
      brandName={brand.name}
      enName={brand.enName}
      accentColor={brand.accentColor}
      foundedYear={brand.foundedYear}
      routeType={brand.routeType}
      protocols={brand.protocols}
      clientModeLabel={brand.clientModeLabel}
      deviceLimit={brand.deviceLimit}
      entryText={entryLabel}
      dataStatus={brand.dataStatus}
    />
  )}

  {brand && (
    <PricingTable
      brandName={brand.name}
      plans={brandPlans}
      fallbackText={brand.fallbackEntryText}
    />
  )}

  <div class="prose-editorial bg-white rounded-xl border border-slate-200 p-6 sm:p-8">
    <Content />
  </div>

  {brand && benchmark && (
    <SpeedReportChart
      brandName={brand.name}
      accentColor={brand.accentColor}
      textRecord20261019={benchmark.textRecord20261019}
      screenshot20260811={benchmark.screenshot20260811}
      additionalScreenshots={benchmark.additionalScreenshots}
      specialSummaryNote={benchmark.specialSummaryNote}
    />
  )}

  {brand && unlock && (
    <AvailabilityMatrixChart
      brandName={brand.name}
      accentColor={brand.accentColor}
      supported={unlock.supported}
      conditional={unlock.conditional}
      rawNote={unlock.rawNote}
      dataStatus={unlock.dataStatus}
    />
  )}

  {brand && (
    <NetworkPathChart
      brandName={brand.name}
      accentColor={brand.accentColor}
      routeType={brand.routeType}
      protocols={brand.protocols}
    />
  )}

  {brand && compat && (
    <ClientCompatibility
      brandName={brand.name}
      mode={compat.mode}
      modeLabel={compat.modeLabel}
      supportsProprietary={compat.supportsProprietaryClient}
      supportsThirdParty={compat.supportsThirdPartySubscription}
      recommendedClients={compat.recommendedClients}
      dataStatus={compat.dataStatus}
    />
  )}

  {brand && sourceObj && (
    <SourceReferences
      brandName={brand.name}
      sources={sourceObj.sources}
      conflicts={sourceObj.conflicts}
    />
  )}
</ArticleLayout>
